        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam nodesep 35\nskinparam ranksep 45\n\nactor \&quot;Quản trị viên\&quot; as AD\nactor \&quot;Nhân viên\&quot; as NV\n\nrectangle \&quot;UC05 - PHÂN CÔNG NHÂN VIÊN XỬ LÝ\&quot; {\n\n    usecase \&quot;Phân công nhân viên xử lý\&quot; as UC1\n\n    usecase \&quot;Xem danh sách yêu cầu\&quot; as UC2\n    usecase \&quot;Xem chi tiết yêu cầu\&quot; as UC3\n    usecase \&quot;Xem danh sách nhân viên\&quot; as UC4\n    usecase \&quot;Kiểm tra trạng thái nhân viên\&quot; as UC5\n    usecase \&quot;Lựa chọn nhân viên xử lý\&quot; as UC6\n    usecase \&quot;Lưu thông tin phân công\&quot; as UC7\n\n    usecase \&quot;Thay đổi nhân viên xử lý\&quot; as UC8\n    usecase \&quot;Cập nhật lịch sử trạng thái\&quot; as UC9\n\n    usecase \&quot;Xem yêu cầu được phân công\&quot; as UC10\n}\n\nAD -- UC1\nAD -- UC8\n\nNV -- UC10\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\n\nUC8 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\nUC7 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FQ4542MsARfvRdixHrrT-162">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
