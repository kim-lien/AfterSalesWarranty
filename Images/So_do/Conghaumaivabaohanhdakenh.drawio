        <UserObject label="QUY TRÌNH QUẢN LÝ TRAO ĐỔI ĐA KÊNH" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="QUY TRÌNH QUẢN LÝ TRAO ĐỔI ĐA KÊNH" id="z9bTDl4ocYqGeueVvAJh-589">
          <mxCell parent="z9bTDl4ocYqGeueVvAJh-542" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="303" x="1152.25" y="2720" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle QUY TRÌNH THEO DÕI SLA VÀ HOÀN TẤT YÊU CẦU\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\n|Nhân viên|\nstart\n:Truy cập danh sách yêu cầu;\n:Chọn yêu cầu đang xử lý;\n\n|Hệ thống|\n:Hiển thị tiến độ và thời hạn SLA;\n:Kiểm tra hạn phản hồi và hạn xử lý;\n\nif (Có vi phạm SLA?) then (Có)\n    :Ghi nhận tình trạng quá hạn;\n    :Hiển thị cảnh báo SLA;\nelse (Không)\n    :Hiển thị trạng thái SLA bình thường;\nendif\n\n|Nhân viên|\n:Kiểm tra kết quả xử lý;\n\nif (Yêu cầu đã được giải quyết?) then (Có)\n    :Ghi nhận kết quả cuối cùng;\n    :Xác nhận hoàn tất xử lý;\n\n    |Hệ thống|\n    :Lưu kết quả giải quyết;\n    :Cập nhật trạng thái \&quot;Đã xử lý\&quot;;\n    :Ghi nhận lịch sử trạng thái;\n\n    |Nhân viên|\n    :Đóng yêu cầu;\n\n    |Hệ thống|\n    :Cập nhật trạng thái \&quot;Đã đóng\&quot;;\n    :Ghi nhận thời gian đóng yêu cầu;\n    :Lưu lịch sử trạng thái;\nelse (Không)\n    |Nhân viên|\n    :Tiếp tục xử lý yêu cầu;\n\n    |Hệ thống|\n    :Giữ trạng thái \&quot;Đang xử lý\&quot;;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z9bTDl4ocYqGeueVvAJh-593">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
