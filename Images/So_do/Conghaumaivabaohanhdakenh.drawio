        <UserObject label="QUY TRÌNH XỬ LÝ HẬU MÃI VÀ CHĂM SÓC CÂY" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="QUY TRÌNH XỬ LÝ HẬU MÃI VÀ CHĂM SÓC CÂY" id="z9bTDl4ocYqGeueVvAJh-479">
          <mxCell parent="z9bTDl4ocYqGeueVvAJh-429" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="337" x="1174.25" y="1690" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle QUY TRÌNH TẠO VÀ THỰC HIỆN LỊCH HẸN\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\n|Quản trị viên|\nstart\n:Truy cập quản lý lịch hẹn;\n:Chọn yêu cầu hậu mãi;\n:Nhập loại công việc,\\nthời gian và địa điểm;\n:Chọn nhân viên thực hiện;\n\n|Hệ thống|\n:Kiểm tra thông tin lịch hẹn;\n\nif (Thông tin hợp lệ?) then (Có)\n    :Lưu lịch hẹn;\n    :Ghi nhận nhân viên được phân công;\n    :Đặt trạng thái \&quot;Chờ xác nhận\&quot;;\n\n    |Nhân viên|\n    :Xem lịch hẹn được phân công;\n    :Kiểm tra thông tin công việc;\n\n    if (Xác nhận thực hiện?) then (Có)\n        |Hệ thống|\n        :Cập nhật trạng thái \&quot;Đã xác nhận\&quot;;\n\n        |Nhân viên|\n        :Thực hiện chăm sóc cây\\nđúng lịch hẹn;\n        :Ghi nhận kết quả công việc;\n        :Cập nhật chi phí thực tế nếu có;\n\n        |Hệ thống|\n        :Lưu kết quả thực hiện;\n        :Cập nhật trạng thái \&quot;Hoàn thành\&quot;;\n\n    else (Không)\n        |Hệ thống|\n        :Ghi nhận lịch chưa được xác nhận;\n    endif\n\nelse (Không)\n    :Thông báo thông tin không hợp lệ;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z9bTDl4ocYqGeueVvAJh-483">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
