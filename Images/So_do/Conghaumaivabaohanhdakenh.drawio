        <UserObject label="QUY TRÌNH PHÂN CÔNG NHÂN VIÊN XỬ LÝ" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="QUY TRÌNH PHÂN CÔNG NHÂN VIÊN XỬ LÝ" id="z9bTDl4ocYqGeueVvAJh-252">
          <mxCell parent="z9bTDl4ocYqGeueVvAJh-221" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="311" x="1067" y="70" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle QUY TRÌNH XỬ LÝ BẢO HÀNH\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\n|Nhân viên|\nstart\n:Chọn yêu cầu bảo hành được phân công;\n\n|Hệ thống|\n:Hiển thị hồ sơ bảo hành;\n:Hiển thị chính sách bảo hành;\n\n|Nhân viên|\n:Kiểm tra điều kiện bảo hành;\n\nif (Đủ điều kiện bảo hành?) then (Có)\n    :Kiểm tra tình trạng cây;\n    :Xác định nguyên nhân hư hỏng;\n    :Lựa chọn phương án xử lý;\n    :Thực hiện xử lý bảo hành;\n\n    if (Xử lý thành công?) then (Có)\n        :Ghi nhận kết quả bảo hành;\n\n        |Hệ thống|\n        :Lưu kết quả bảo hành;\n        :Cập nhật trạng thái \&quot;Đã xử lý\&quot;;\n    else (Không)\n        |Nhân viên|\n        :Ghi nhận vấn đề chưa giải quyết;\n\n        |Hệ thống|\n        :Lưu kết quả kiểm tra;\n        :Giữ trạng thái \&quot;Đang xử lý\&quot;;\n    endif\n\nelse (Không)\n    :Ghi nhận lý do từ chối;\n\n    |Hệ thống|\n    :Lưu lý do từ chối;\n    :Cập nhật trạng thái \&quot;Từ chối\&quot;;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z9bTDl4ocYqGeueVvAJh-255">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Nhân viên" plantUmlId="lane_71" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;rounded=1;arcSize=10;absoluteArcSize=1;shadow=0;fontFamily=Arial;" plantUmlBaseValue="Nhân viên" id="z9bTDl4ocYqGeueVvAJh-256">
