        <UserObject label="Sơ đồ tuần tự Tiếp nhận yêu cầu hậu mãi và bảo hành đa kênh" plantUmlId="title_46" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sơ đồ tuần tự Tiếp nhận yêu cầu hậu mãi và bảo hành đa kênh" id="fi8XJBjtkOU-Sy3EsDHG-229">
