        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam nodesep 35\nskinparam ranksep 45\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;Quản trị viên\&quot; as AD\n\nrectangle \&quot;UC03 - TIẾP NHẬN YÊU CẦU HẬU MÃI VÀ BẢO HÀNH ĐA KÊNH\&quot; {\n\n    usecase \&quot;Gửi yêu cầu hỗ trợ\&quot; as UC1\n    usecase \&quot;Chọn kênh tiếp nhận\&quot; as UC2\n    usecase \&quot;Chọn đơn mua / đơn thuê\&quot; as UC3\n    usecase \&quot;Chọn sản phẩm cần hỗ trợ\&quot; as UC4\n    usecase \&quot;Chọn loại yêu cầu\&quot; as UC5\n    usecase \&quot;Nhập nội dung yêu cầu\&quot; as UC6\n    usecase \&quot;Đính kèm hình ảnh\&quot; as UC7\n\n    usecase \&quot;Kiểm tra thông tin yêu cầu\&quot; as UC8\n    usecase \&quot;Kiểm tra đơn hàng và sản phẩm\&quot; as UC9\n    usecase \&quot;Ghi nhận hồ sơ yêu cầu\&quot; as UC10\n    usecase \&quot;Ghi nhận kênh tiếp nhận\&quot; as UC11\n    usecase \&quot;Xem danh sách yêu cầu\&quot; as UC12\n}\n\nKH -- UC1\nNV -- UC12\nAD -- UC12\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\n\nUC7 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\nUC8 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FQ4542MsARfvRdixHrrT-99">
