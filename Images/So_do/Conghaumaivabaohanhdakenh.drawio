        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam nodesep 35\nskinparam ranksep 45\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;Quản trị viên\&quot; as AD\n\nrectangle \&quot;UC07 - XỬ LÝ HẬU MÃI VÀ CHĂM SÓC CÂY\&quot; {\n\n    usecase \&quot;Xử lý hậu mãi\&quot; as UC1\n\n    usecase \&quot;Xem chi tiết yêu cầu\&quot; as UC2\n    usecase \&quot;Kiểm tra chính sách dịch vụ\&quot; as UC3\n    usecase \&quot;Đánh giá nhu cầu chăm sóc\&quot; as UC4\n    usecase \&quot;Tư vấn chăm sóc cây\&quot; as UC5\n    usecase \&quot;Ghi nhận phương án xử lý\&quot; as UC6\n    usecase \&quot;Cập nhật kết quả hậu mãi\&quot; as UC7\n    usecase \&quot;Cập nhật trạng thái yêu cầu\&quot; as UC8\n\n    usecase \&quot;Yêu cầu bổ sung thông tin\&quot; as UC9\n    usecase \&quot;Đề xuất lịch hẹn chăm sóc\&quot; as UC10\n    usecase \&quot;Ghi nhận chi phí dịch vụ\&quot; as UC11\n\n    usecase \&quot;Cung cấp thông tin bổ sung\&quot; as UC12\n    usecase \&quot;Theo dõi kết quả hậu mãi\&quot; as UC13\n    usecase \&quot;Giám sát xử lý hậu mãi\&quot; as UC14\n}\n\nNV -- UC1\nNV -- UC9\nNV -- UC10\n\nAD -- UC14\n\nKH -- UC12\nKH -- UC13\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\n\nUC7 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\n\nUC9 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC10 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC11 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FQ4542MsARfvRdixHrrT-229">
