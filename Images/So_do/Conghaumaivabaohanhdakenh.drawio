        <mxCell id="9XCmVe7eXxoyvz2fltxd-273" parent="9XCmVe7eXxoyvz2fltxd-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;SƠ ĐỒ LỚP (MỨC PHÂN TÍCH)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="500" x="-370" y="60" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle SƠ ĐỒ LOGIC CƠ SỞ DỮ LIỆU QUẢN LÝ CÂY CẢNH\n\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 5\nskinparam defaultFontName Arial\nskinparam classAttributeIconSize 0\nskinparam nodesep 40\nskinparam ranksep 50\n\nentity \&quot;VaiTro\&quot; as VaiTro {\n    * MaVaiTro : INT &lt;&lt;PK&gt;&gt;\n    --\n    TenVaiTro : NVARCHAR(50)\n    MoTa : NVARCHAR(255)\n}\n\nentity \&quot;NguoiDung\&quot; as NguoiDung {\n    * MaNguoiDung : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaVaiTro : INT &lt;&lt;FK&gt;&gt;\n    HoTen : NVARCHAR(100)\n    Email : VARCHAR(150)\n    MatKhau : VARCHAR(255)\n    SDT : VARCHAR(15)\n    TrangThai : BIT\n    NgayTao : DATETIME2\n}\n\nentity \&quot;KhachHang\&quot; as KhachHang {\n    * MaKH : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaNguoiDung : INT &lt;&lt;FK, UNIQUE&gt;&gt;\n    NgaySinh : DATE\n    GioiTinh : NVARCHAR(20)\n    DiemTichLuy : INT\n    DaXacMinhDanhTinh : BIT\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n    * MaNV : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaNguoiDung : INT &lt;&lt;FK, UNIQUE&gt;&gt;\n    ChucVu : NVARCHAR(100)\n    NgayVaoLam : DATE\n    TrangThai : BIT\n}\n\nentity \&quot;DiaChi\&quot; as DiaChi {\n    * MaDiaChi : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaNguoiDung : INT &lt;&lt;FK&gt;&gt;\n    TenNguoiNhan : NVARCHAR(100)\n    SDT : VARCHAR(15)\n    TinhThanh : NVARCHAR(100)\n    PhuongXa : NVARCHAR(100)\n    DiaChiChiTiet : NVARCHAR(255)\n    MacDinh : BIT\n}\n\nentity \&quot;Kho\&quot; as Kho {\n    * MaKho : INT &lt;&lt;PK&gt;&gt;\n    --\n    TenKho : NVARCHAR(150)\n    DiaChi : NVARCHAR(255)\n    TrangThai : BIT\n}\n\nentity \&quot;DanhMuc\&quot; as DanhMuc {\n    * MaDM : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaDMCha : INT &lt;&lt;FK&gt;&gt;\n    TenDM : NVARCHAR(100)\n    MoTa : NVARCHAR(MAX)\n    TrangThai : BIT\n}\n\nentity \&quot;SanPham\&quot; as SanPham {\n    * MaSP : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaDM : INT &lt;&lt;FK&gt;&gt;\n    TenSP : NVARCHAR(150)\n    LoaiSanPham : NVARCHAR(30)\n    GiaBan : DECIMAL(18,2)\n    GiaThueTheoNgay : DECIMAL(18,2)\n    GiaTriCay : DECIMAL(18,2)\n    DuDieuKienBaoHanh : BIT\n    HuongDanChamSoc : NVARCHAR(MAX)\n    TrangThai : BIT\n}\n\nentity \&quot;TonKho\&quot; as TonKho {\n    * MaTonKho : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaKho : INT &lt;&lt;FK&gt;&gt;\n    MaSP : INT &lt;&lt;FK&gt;&gt;\n    SoLuongTon : INT\n    SoLuongDangThue : INT\n    NgayCapNhat : DATETIME2\n}\n\nentity \&quot;KhuyenMai\&quot; as KhuyenMai {\n    * MaKM : INT &lt;&lt;PK&gt;&gt;\n    --\n    TenKM : NVARCHAR(150)\n    LoaiKM : NVARCHAR(30)\n    NgayBatDau : DATETIME2\n    NgayKetThuc : DATETIME2\n    TrangThai : BIT\n}\n\nentity \&quot;ChinhSachDichVu\&quot; as ChinhSachDichVu {\n    * MaChinhSach : INT &lt;&lt;PK&gt;&gt;\n    --\n    TenDichVu : NVARCHAR(150)\n    NhomDichVu : NVARCHAR(30)\n    HinhThuc : NVARCHAR(20)\n    GoiApDung : NVARCHAR(30)\n    SoNgayToiDa : INT\n    SoGioToiDa : INT\n    PhiMacDinh : DECIMAL(18,2)\n    HieuLucTu : DATE\n    HieuLucDen : DATE\n    TrangThai : BIT\n}\n\nentity \&quot;ChiTietKhuyenMai\&quot; as ChiTietKhuyenMai {\n    * MaCTKM : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaKM : INT &lt;&lt;FK&gt;&gt;\n    MaSP : INT &lt;&lt;FK&gt;&gt;\n    MaChinhSach : INT &lt;&lt;FK&gt;&gt;\n    DoiTuong : NVARCHAR(30)\n    PhanTramGiam : DECIMAL(5,2)\n    GiaKhuyenMai : DECIMAL(18,2)\n}\n\nentity \&quot;GioHang\&quot; as GioHang {\n    * MaGioHang : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaKH : INT &lt;&lt;FK&gt;&gt;\n    NgayTao : DATETIME2\n    NgayCapNhat : DATETIME2\n}\n\nentity \&quot;ChiTietGioHang\&quot; as ChiTietGioHang {\n    * MaCTGH : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaGioHang : INT &lt;&lt;FK&gt;&gt;\n    MaSP : INT &lt;&lt;FK&gt;&gt;\n    SoLuong : INT\n    LoaiGiaoDich : NVARCHAR(20)\n    NgayBatDauThue : DATE\n    NgayKetThucThue : DATE\n}\n\nentity \&quot;DonHang\&quot; as DonHang {\n    * MaDH : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaKH : INT &lt;&lt;FK&gt;&gt;\n    MaNV : INT &lt;&lt;FK&gt;&gt;\n    MaDiaChiGiao : INT &lt;&lt;FK&gt;&gt;\n    MaKho : INT &lt;&lt;FK&gt;&gt;\n    TrangThai : NVARCHAR(40)\n    GiamGiaDon : DECIMAL(18,2)\n    PhiVanChuyen : DECIMAL(18,2)\n    TrangThaiThanhToan : NVARCHAR(40)\n    NgayDat : DATETIME2\n}\n\nentity \&quot;ChiTietDonHang\&quot; as ChiTietDonHang {\n    * MaCTDH : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaDH : INT &lt;&lt;FK&gt;&gt;\n    MaSP : INT &lt;&lt;FK&gt;&gt;\n    MaCTKM : INT &lt;&lt;FK&gt;&gt;\n    SoLuong : INT\n    DonGia : DECIMAL(18,2)\n    CoGoiBaoHanh : BIT\n    CoGoiChamSoc : BIT\n}\n\nentity \&quot;DonThue\&quot; as DonThue {\n    * MaDT : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaKH : INT &lt;&lt;FK&gt;&gt;\n    MaNV : INT &lt;&lt;FK&gt;&gt;\n    MaDiaChiGiao : INT &lt;&lt;FK&gt;&gt;\n    MaKho : INT &lt;&lt;FK&gt;&gt;\n    NgayBatDau : DATE\n    NgayKetThuc : DATE\n    GoiThue : NVARCHAR(30)\n    TienCocDuKien : DECIMAL(18,2)\n    TienCocDaThu : DECIMAL(18,2)\n    TrangThai : NVARCHAR(40)\n    TrangThaiCoc : NVARCHAR(40)\n}\n\nentity \&quot;ChiTietDonThue\&quot; as ChiTietDonThue {\n    * MaCTDT : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaDT : INT &lt;&lt;FK&gt;&gt;\n    MaSP : INT &lt;&lt;FK&gt;&gt;\n    MaCTKM : INT &lt;&lt;FK&gt;&gt;\n    MaNVKiemTra : INT &lt;&lt;FK&gt;&gt;\n    SoLuong : INT\n    GiaThueTheoNgay : DECIMAL(18,2)\n    TienCoc : DECIMAL(18,2)\n    TinhTrangKhiGiao : NVARCHAR(500)\n    TinhTrangKhiTra : NVARCHAR(500)\n}\n\nentity \&quot;ThanhToan\&quot; as ThanhToan {\n    * MaTT : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaDH : INT &lt;&lt;FK&gt;&gt;\n    MaDT : INT &lt;&lt;FK&gt;&gt;\n    LoaiThanhToan : NVARCHAR(40)\n    SoTien : DECIMAL(18,2)\n    PhuongThuc : NVARCHAR(40)\n    TrangThai : NVARCHAR(40)\n    ThoiGian : DATETIME2\n}\n\nentity \&quot;DanhGia\&quot; as DanhGia {\n    * MaDG : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaKH : INT &lt;&lt;FK&gt;&gt;\n    MaSP : INT &lt;&lt;FK&gt;&gt;\n    SoSao : INT\n    NoiDung : NVARCHAR(500)\n    NgayDanhGia : DATETIME2\n    TrangThai : BIT\n}\n\nentity \&quot;KenhHoTro\&quot; as KenhHoTro {\n    * MaKenh : INT &lt;&lt;PK&gt;&gt;\n    --\n    TenKenh : NVARCHAR(100)\n    TrangThai : BIT\n}\n\nentity \&quot;YeuCauHauMai\&quot; as YeuCauHauMai {\n    * MaYC : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaKH : INT &lt;&lt;FK&gt;&gt;\n    MaDH : INT &lt;&lt;FK&gt;&gt;\n    MaDT : INT &lt;&lt;FK&gt;&gt;\n    MaCTDH : INT &lt;&lt;FK&gt;&gt;\n    MaCTDT : INT &lt;&lt;FK&gt;&gt;\n    MaChinhSach : INT &lt;&lt;FK&gt;&gt;\n    MaNVTiepNhan : INT &lt;&lt;FK&gt;&gt;\n    MaNVXuLy : INT &lt;&lt;FK&gt;&gt;\n    MaKenhTiepNhan : INT &lt;&lt;FK&gt;&gt;\n    NhomYeuCau : NVARCHAR(30)\n    LoaiYeuCau : NVARCHAR(100)\n    TieuDe : NVARCHAR(200)\n    MucDo : NVARCHAR(30)\n    TrangThai : NVARCHAR(40)\n    NgayTao : DATETIME2\n    HanPhanHoi : DATETIME2\n    HanXuLy : DATETIME2\n    NgayPhanHoiDau : DATETIME2\n    NgayDong : DATETIME2\n    KetQua : NVARCHAR(MAX)\n}\n\nentity \&quot;BaoHanh\&quot; as BaoHanh {\n    * MaBH : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaYC : INT &lt;&lt;FK, UNIQUE&gt;&gt;\n    MaNVXacMinh : INT &lt;&lt;FK&gt;&gt;\n    NgayBatDau : DATETIME2\n    NgayHetHan : DATETIME2\n    NguyenNhan : NVARCHAR(500)\n    KetQuaKiemTra : NVARCHAR(MAX)\n    HuongXuLy : NVARCHAR(40)\n    TrangThai : NVARCHAR(40)\n    NgayXacMinh : DATETIME2\n}\n\nentity \&quot;LichSuTrangThai\&quot; as LichSuTrangThai {\n    * MaLSTS : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    MaYC : INT &lt;&lt;FK&gt;&gt;\n    MaNguoiThayDoi : INT &lt;&lt;FK&gt;&gt;\n    TrangThaiCu : NVARCHAR(40)\n    TrangThaiMoi : NVARCHAR(40)\n    LyDo : NVARCHAR(MAX)\n    ThoiGian : DATETIME2\n}\n\nentity \&quot;LichSuTuongTac\&quot; as LichSuTuongTac {\n    * MaTuongTac : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    MaYC : INT &lt;&lt;FK&gt;&gt;\n    MaNguoiDung : INT &lt;&lt;FK&gt;&gt;\n    MaKenh : INT &lt;&lt;FK&gt;&gt;\n    MaTinNhanNgoai : VARCHAR(150)\n    NguoiGuiNgoai : NVARCHAR(150)\n    LoaiTuongTac : NVARCHAR(40)\n    NoiDung : NVARCHAR(MAX)\n    TepDinhKem : VARCHAR(1000)\n    ThoiGian : DATETIME2\n}\n\nentity \&quot;LichHenChamSoc\&quot; as LichHenChamSoc {\n    * MaLich : INT &lt;&lt;PK&gt;&gt;\n    --\n    MaYC : INT &lt;&lt;FK&gt;&gt;\n    MaNV : INT &lt;&lt;FK&gt;&gt;\n    LoaiCongViec : NVARCHAR(50)\n    NgayHen : DATETIME2\n    NgayHoanTat : DATETIME2\n    DiaDiem : NVARCHAR(500)\n    PhiDuKien : DECIMAL(18,2)\n    PhiThucTe : DECIMAL(18,2)\n    KhachDongYPhi : BIT\n    TrangThai : NVARCHAR(40)\n    KetQua : NVARCHAR(MAX)\n}\n\nVaiTro ||--o{ NguoiDung\nNguoiDung ||--o| KhachHang\nNguoiDung ||--o| NhanVien\nNguoiDung ||--o{ DiaChi\n\nDanhMuc |o--o{ DanhMuc : danh mục cha\nDanhMuc ||--o{ SanPham\nKho ||--o{ TonKho\nSanPham ||--o{ TonKho\n\nKhuyenMai ||--o{ ChiTietKhuyenMai\nSanPham |o--o{ ChiTietKhuyenMai\nChinhSachDichVu |o--o{ ChiTietKhuyenMai\n\nKhachHang ||--o| GioHang\nGioHang ||--o{ ChiTietGioHang\nSanPham ||--o{ ChiTietGioHang\n\nKhachHang ||--o{ DonHang\nNhanVien |o--o{ DonHang\nDiaChi ||--o{ DonHang\nKho ||--o{ DonHang\n\nDonHang ||--o{ ChiTietDonHang\nSanPham ||--o{ ChiTietDonHang\nChiTietKhuyenMai |o--o{ ChiTietDonHang\n\nKhachHang ||--o{ DonThue\nNhanVien |o--o{ DonThue\nDiaChi ||--o{ DonThue\nKho ||--o{ DonThue\n\nDonThue ||--o{ ChiTietDonThue\nSanPham ||--o{ ChiTietDonThue\nChiTietKhuyenMai |o--o{ ChiTietDonThue\nNhanVien |o--o{ ChiTietDonThue : kiểm tra\n\nDonHang |o--o{ ThanhToan\nDonThue |o--o{ ThanhToan\n\nKhachHang ||--o{ DanhGia\nSanPham ||--o{ DanhGia\n\nKhachHang ||--o{ YeuCauHauMai\nDonHang |o--o{ YeuCauHauMai\nDonThue |o--o{ YeuCauHauMai\nChiTietDonHang |o--o{ YeuCauHauMai\nChiTietDonThue |o--o{ YeuCauHauMai\n\nChinhSachDichVu |o--o{ YeuCauHauMai\nKenhHoTro ||--o{ YeuCauHauMai\nNhanVien |o--o{ YeuCauHauMai : tiếp nhận\nNhanVien |o--o{ YeuCauHauMai : xử lý\n\nYeuCauHauMai ||--o| BaoHanh\nNhanVien |o--o{ BaoHanh : xác minh\n\nYeuCauHauMai ||--o{ LichSuTrangThai\nNguoiDung ||--o{ LichSuTrangThai\n\nYeuCauHauMai ||--o{ LichSuTuongTac\nNguoiDung |o--o{ LichSuTuongTac\nKenhHoTro ||--o{ LichSuTuongTac\n\nYeuCauHauMai ||--o{ LichHenChamSoc\nNhanVien |o--o{ LichHenChamSoc\n\nnote bottom of YeuCauHauMai\nMỗi yêu cầu liên kết với đúng một\ngiao dịch mua hoặc thuê và chi tiết\nsản phẩm tương ứng.\n\nMaChinhSach, MaNVTiepNhan,\nMaNVXuLy có thể NULL.\n\nSLA lưu trực tiếp trong bảng này.\nend note\n\nnote bottom of BaoHanh\nMaYC là khóa ngoại UNIQUE.\nMỗi yêu cầu có tối đa một\nhồ sơ bảo hành.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Fc8Z2jhbTgNjcZEnTFF5-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
