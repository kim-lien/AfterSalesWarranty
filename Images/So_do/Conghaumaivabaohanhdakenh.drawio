        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle QUY TRÌNH QUẢN LÝ TRAO ĐỔI ĐA KÊNH\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\n|Khách hàng|\nstart\n:Chọn kênh liên hệ;\n:Gửi nội dung trao đổi;\n\nif (Kênh liên hệ?) then (Website)\n    |Hệ thống|\n    :Tiếp nhận nội dung;\nelse (Kênh khác)\n    |Nhân viên|\n    :Tiếp nhận thông tin qua\\nEmail, điện thoại hoặc Chat;\n    :Ghi nhận nội dung trao đổi;\nendif\n\n|Hệ thống|\n:Xác định yêu cầu liên quan;\n:Lưu nội dung và kênh tương tác;\n\n|Nhân viên|\n:Xem nội dung khách hàng gửi;\n:Kiểm tra thông tin yêu cầu;\n:Soạn nội dung phản hồi;\n\n|Hệ thống|\n:Ghi nhận phản hồi của nhân viên;\n:Lưu lịch sử tương tác;\n\nif (Kênh phản hồi?) then (Website)\n    :Hiển thị phản hồi trên Website;\nelse (Kênh khác)\n    |Nhân viên|\n    :Gửi phản hồi qua\\nkênh liên hệ tương ứng;\nendif\n\n|Khách hàng|\n:Tiếp nhận phản hồi;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z9bTDl4ocYqGeueVvAJh-542">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
