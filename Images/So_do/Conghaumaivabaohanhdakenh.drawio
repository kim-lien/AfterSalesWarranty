        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam nodesep 35\nskinparam ranksep 45\n\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;Quản trị viên\&quot; as AD\n\nrectangle \&quot;UC04 - XÁC MINH YÊU CẦU VÀ CHÍNH SÁCH DỊCH VỤ\&quot; {\n\n    usecase \&quot;Xác minh yêu cầu\&quot; as UC1\n\n    usecase \&quot;Xem chi tiết yêu cầu\&quot; as UC2\n    usecase \&quot;Kiểm tra thông tin khách hàng\&quot; as UC3\n    usecase \&quot;Kiểm tra đơn mua / đơn thuê\&quot; as UC4\n    usecase \&quot;Kiểm tra sản phẩm liên quan\&quot; as UC5\n    usecase \&quot;Tra cứu chính sách dịch vụ\&quot; as UC6\n    usecase \&quot;Kiểm tra thời hạn hỗ trợ\&quot; as UC7\n    usecase \&quot;Đánh giá điều kiện áp dụng\&quot; as UC8\n\n    usecase \&quot;Yêu cầu bổ sung thông tin\&quot; as UC9\n    usecase \&quot;Ghi nhận kết quả xác minh\&quot; as UC10\n    usecase \&quot;Cập nhật trạng thái yêu cầu\&quot; as UC11\n}\n\nNV -- UC1\nAD -- UC1\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\n\nUC6 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC8 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\n\nUC9 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\nUC10 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FQ4542MsARfvRdixHrrT-132">
