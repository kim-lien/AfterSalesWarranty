  <diagram id="eJYgdkDnAcPKIIrqCWLz" name="Sơ đồ Class - Sơ đồ logic">
    <mxGraphModel dx="4464" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntop to bottom direction\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 6\nskinparam classAttributeIconSize 0\nskinparam defaultFontName Arial\nskinparam nodesep 35\nskinparam ranksep 45\nhide circle\n\nclass VaiTro {\n    MaVaiTro: int\n    TenVaiTro: string\n    MoTa: string\n}\n\nclass NguoiDung {\n    MaNguoiDung: int\n    MaVaiTro: int\n    HoTen: string\n    Email: string\n    MatKhau: string\n    SDT: string\n    TrangThai: boolean\n    --\n    dangNhap()\n    capNhatThongTin()\n}\n\nclass KhachHang {\n    MaKH: int\n    MaNguoiDung: int\n    DiemTichLuy: int\n    DaXacMinhDanhTinh: boolean\n    --\n    xemLichSuDonHang()\n    guiYeuCauHoTro()\n    theoDoiYeuCau()\n}\n\nclass NhanVien {\n    MaNV: int\n    MaNguoiDung: int\n    ChucVu: string\n    TrangThai: boolean\n    --\n    tiepNhanYeuCau()\n    xacMinhYeuCau()\n    xuLyYeuCau()\n    capNhatKetQua()\n}\n\nclass SanPham {\n    MaSP: int\n    TenSP: string\n    LoaiSanPham: string\n    GiaBan: decimal\n    GiaThueTheoNgay: decimal\n    GiaTriCay: decimal\n    DuDieuKienBaoHanh: boolean\n    HuongDanChamSoc: string\n    --\n    xemChiTiet()\n    kiemTraDieuKienBaoHanh()\n}\n\nclass DonHang {\n    MaDH: int\n    MaKH: int\n    MaNV: int\n    TrangThai: string\n    NgayDat: datetime\n    --\n    taoDonHang()\n    capNhatTrangThai()\n}\n\nclass ChiTietDonHang {\n    MaCTDH: int\n    MaDH: int\n    MaSP: int\n    SoLuong: int\n    DonGia: decimal\n    CoGoiBaoHanh: boolean\n    CoGoiChamSoc: boolean\n}\n\nclass DonThue {\n    MaDT: int\n    MaKH: int\n    MaNV: int\n    NgayBatDau: date\n    NgayKetThuc: date\n    GoiThue: string\n    TrangThai: string\n    --\n    taoDonThue()\n    capNhatTrangThai()\n}\n\nclass ChiTietDonThue {\n    MaCTDT: int\n    MaDT: int\n    MaSP: int\n    SoLuong: int\n    TienCoc: decimal\n    TinhTrangKhiGiao: string\n    TinhTrangKhiTra: string\n    --\n    ghiNhanTinhTrangCay()\n}\n\nclass ChinhSachDichVu {\n    MaChinhSach: int\n    TenDichVu: string\n    NhomDichVu: string\n    HinhThuc: string\n    GoiApDung: string\n    SoNgayToiDa: int\n    PhiMacDinh: decimal\n    TrangThai: boolean\n    --\n    kiemTraDieuKien()\n    xacDinhThoiHan()\n}\n\nclass KenhHoTro {\n    MaKenh: int\n    TenKenh: string\n    TrangThai: boolean\n}\n\nclass YeuCauHauMai {\n    MaYC: int\n    MaKH: int\n    MaChinhSach: int\n    MaNVTiepNhan: int\n    MaNVXuLy: int\n    MaKenhTiepNhan: int\n    NhomYeuCau: string\n    LoaiYeuCau: string\n    TieuDe: string\n    MoTa: string\n    MucDo: string\n    TrangThai: string\n    NgayTao: datetime\n    HanPhanHoi: datetime\n    HanXuLy: datetime\n    NgayPhanHoiDau: datetime\n    NgayDong: datetime\n    KetQua: string\n    --\n    taoYeuCau()\n    xacMinhYeuCau()\n    phanCongNhanVien()\n    capNhatTrangThai()\n    kiemTraSLA()\n    hoanTatYeuCau()\n}\n\nclass BaoHanh {\n    MaBH: int\n    MaYC: int\n    MaNVXacMinh: int\n    NgayBatDau: datetime\n    NgayHetHan: datetime\n    NguyenNhan: string\n    KetQuaKiemTra: string\n    HuongXuLy: string\n    TrangThai: string\n    --\n    kiemTraBaoHanh()\n    xacDinhNguyenNhan()\n    capNhatHuongXuLy()\n    ghiNhanKetQua()\n}\n\nclass LichHenChamSoc {\n    MaLich: int\n    MaYC: int\n    MaNV: int\n    LoaiCongViec: string\n    NgayHen: datetime\n    NgayHoanTat: datetime\n    DiaDiem: string\n    PhiDuKien: decimal\n    PhiThucTe: decimal\n    TrangThai: string\n    KetQua: string\n    --\n    taoLichHen()\n    phanCongNhanVien()\n    capNhatTrangThai()\n    ghiNhanKetQua()\n}\n\nclass LichSuTuongTac {\n    MaYC: int\n    MaNguoiDung: int\n    MaKenh: int\n    LoaiTuongTac: string\n    NoiDung: string\n    TepDinhKem: string\n    ThoiGian: datetime\n    --\n    ghiNhanTuongTac()\n    xemLichSuTraoDoi()\n}\n\nclass LichSuTrangThai {\n    MaYC: int\n    MaNguoiThayDoi: int\n    TrangThaiCu: string\n    TrangThaiMoi: string\n    LyDo: string\n    ThoiGian: datetime\n    --\n    ghiNhanThayDoi()\n}\n\nVaiTro \&quot;1\&quot; -- \&quot;0..*\&quot; NguoiDung : phân quyền\n\nNguoiDung \&quot;1\&quot; -- \&quot;0..1\&quot; KhachHang : hồ sơ khách hàng\nNguoiDung \&quot;1\&quot; -- \&quot;0..1\&quot; NhanVien : hồ sơ nhân viên\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : đặt mua\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonThue : thuê cây\n\nDonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang : chi tiết mua\nDonThue \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonThue : chi tiết thuê\n\nSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDonHang : sản phẩm mua\nSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDonThue : sản phẩm thuê\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauHauMai : gửi yêu cầu\n\nChiTietDonHang \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauHauMai : sản phẩm đã mua\nChiTietDonThue \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauHauMai : sản phẩm đã thuê\n\nChinhSachDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauHauMai : chính sách áp dụng\n\nKenhHoTro \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauHauMai : kênh tiếp nhận\n\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauHauMai : tiếp nhận\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauHauMai : xử lý\n\nYeuCauHauMai \&quot;1\&quot; *-- \&quot;0..1\&quot; BaoHanh : hồ sơ bảo hành\nYeuCauHauMai \&quot;1\&quot; *-- \&quot;0..*\&quot; LichHenChamSoc : lịch chăm sóc\nYeuCauHauMai \&quot;1\&quot; *-- \&quot;0..*\&quot; LichSuTuongTac : lịch sử trao đổi\nYeuCauHauMai \&quot;1\&quot; *-- \&quot;0..*\&quot; LichSuTrangThai : lịch sử trạng thái\n\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; BaoHanh : xác minh\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; LichHenChamSoc : thực hiện\n\nNguoiDung \&quot;0..1\&quot; -- \&quot;0..*\&quot; LichSuTuongTac : người gửi\nNguoiDung \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuTrangThai : thay đổi trạng thái\n\nKenhHoTro \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuTuongTac : kênh tương tác\n\nnote bottom of YeuCauHauMai\nMỗi yêu cầu phải liên kết với\nmột chi tiết đơn mua hoặc\nmột chi tiết đơn thuê.\n\nSLA được quản lý bằng\ncác thuộc tính thời gian,\nkhông có bảng SLA riêng.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9XCmVe7eXxoyvz2fltxd-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
