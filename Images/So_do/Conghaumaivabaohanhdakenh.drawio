        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam nodesep 35\nskinparam ranksep 45\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Quản trị viên\&quot; as AD\nactor \&quot;Nhân viên\&quot; as NV\n\nrectangle \&quot;UC08 - QUẢN LÝ LỊCH HẸN\&quot; {\n\n    usecase \&quot;Quản lý lịch hẹn\&quot; as UC1\n\n    usecase \&quot;Xem danh sách lịch hẹn\&quot; as UC2\n    usecase \&quot;Tạo lịch hẹn\&quot; as UC3\n    usecase \&quot;Chọn yêu cầu hậu mãi\&quot; as UC4\n    usecase \&quot;Chọn loại công việc\&quot; as UC5\n    usecase \&quot;Thiết lập thời gian và địa điểm\&quot; as UC6\n    usecase \&quot;Phân công nhân viên thực hiện\&quot; as UC7\n    usecase \&quot;Lưu thông tin lịch hẹn\&quot; as UC8\n\n    usecase \&quot;Chỉnh sửa lịch hẹn\&quot; as UC9\n    usecase \&quot;Hủy lịch hẹn\&quot; as UC10\n\n    usecase \&quot;Xem lịch được phân công\&quot; as UC11\n    usecase \&quot;Xác nhận lịch hẹn\&quot; as UC12\n    usecase \&quot;Cập nhật trạng thái thực hiện\&quot; as UC13\n    usecase \&quot;Ghi nhận kết quả công việc\&quot; as UC14\n    usecase \&quot;Ghi nhận chi phí thực tế\&quot; as UC15\n\n    usecase \&quot;Xem lịch hẹn của mình\&quot; as UC16\n    usecase \&quot;Theo dõi kết quả lịch hẹn\&quot; as UC17\n}\n\nAD -- UC1\nAD -- UC3\nAD -- UC9\nAD -- UC10\n\nNV -- UC11\nNV -- UC12\nNV -- UC13\nNV -- UC14\nNV -- UC15\n\nKH -- UC16\nKH -- UC17\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\n\nUC3 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\n\nUC9 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC10 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\nUC14 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC14 : &lt;&lt;extend&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FQ4542MsARfvRdixHrrT-267">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
