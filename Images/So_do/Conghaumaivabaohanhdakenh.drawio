        <UserObject label="QUY TRÌNH XỬ LÝ BẢO HÀNH" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="QUY TRÌNH XỬ LÝ BẢO HÀNH" id="z9bTDl4ocYqGeueVvAJh-309">
          <mxCell parent="z9bTDl4ocYqGeueVvAJh-255" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="218" x="1168.75" y="810" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle QUY TRÌNH XÁC MINH YÊU CẦU\n\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\n|Nhân viên|\nstart\n:Truy cập danh sách yêu cầu được phân công;\n:Chọn yêu cầu cần xác minh;\n\n|Hệ thống|\n:Hiển thị thông tin yêu cầu;\n:Hiển thị đơn mua hoặc đơn thuê;\n:Hiển thị chính sách dịch vụ;\n\n|Nhân viên|\n:Kiểm tra thông tin khách hàng;\n:Đối chiếu đơn hàng và sản phẩm;\n\nif (Thông tin hợp lệ?) then (Có)\n    :Kiểm tra điều kiện chính sách dịch vụ;\n\n    if (Đủ điều kiện hỗ trợ?) then (Có)\n        :Xác nhận yêu cầu hợp lệ;\n\n        |Hệ thống|\n        :Lưu kết quả xác minh;\n        :Cập nhật trạng thái \&quot;Đang xử lý\&quot;;\n\n    else (Không)\n        |Nhân viên|\n        :Ghi nhận lý do từ chối;\n\n        |Hệ thống|\n        :Lưu lý do từ chối;\n        :Cập nhật trạng thái \&quot;Từ chối\&quot;;\n    endif\n\nelse (Không)\n    |Nhân viên|\n    :Yêu cầu bổ sung thông tin;\n\n    |Hệ thống|\n    :Ghi nhận yêu cầu bổ sung;\n    :Cập nhật trạng thái \&quot;Chờ khách hàng\&quot;;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z9bTDl4ocYqGeueVvAJh-367">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Nhân viên" plantUmlId="lane_74" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;rounded=1;arcSize=10;absoluteArcSize=1;shadow=0;fontFamily=Arial;" plantUmlBaseValue="Nhân viên" id="z9bTDl4ocYqGeueVvAJh-368">
